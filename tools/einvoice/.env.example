# Copy to .env and fill in. Never commit .env.

# Which Invoice Registration Portal to talk to: nic | iris
#   nic  = NIC IRP (einvoice1). Direct API access only above NIC's turnover threshold.
#   iris = IRIS IRP (einvoice6). Self-service direct API access for taxpayers.
EINV_PORTAL=iris

# sandbox | production
EINV_ENV=sandbox

# API host. Required for iris (copy it from the IRIS portal: Sandbox → Sandbox Settings → Sandbox End Point).
# Optional for nic (defaults to the NIC hosts) or when a GSP mirrors the NIC paths on its own host.
EINV_BASE_URL=

# Core API credentials from the portal account (IRIS: Sandbox → Sandbox Credentials → Client ID / Client Secret)
EINV_CLIENT_ID=
EINV_CLIENT_SECRET=
# The taxpayer's GSTIN and the API user created for it on the portal
EINV_GSTIN=
EINV_USERNAME=
EINV_PASSWORD=

# Path to the portal's RSA public key for this environment.
# Default: keys/<portal>-<env>.pem, e.g. keys/iris-sandbox.pem (IRIS: Public keys page → Core APIs → Sandbox)
# EINV_PUBLIC_KEY=keys/iris-sandbox.pem

# Optional: where the session token is cached (default: .token-<portal>-<env>-<gstin>.json next to this file)
# EINV_TOKEN_FILE=

# Optional: request payload encoding before AES encryption. "base64" (spec, default) or "json".
# EINV_PAYLOAD_ENCODING=base64
