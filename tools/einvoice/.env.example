# Copy to .env and fill in. Never commit .env.

# sandbox | production
EINV_ENV=sandbox

# Optional: override the portal host (e.g. when going through a GSP that mirrors the NIC paths)
# EINV_BASE_URL=https://einv-apisandbox.nic.in

# API credentials issued on the e-invoice portal (sandbox: https://einv-apisandbox.nic.in)
EINV_CLIENT_ID=
EINV_CLIENT_SECRET=
EINV_GSTIN=
EINV_USERNAME=
EINV_PASSWORD=

# Path to the portal's RSA public key (download from the portal; sandbox and production keys differ)
EINV_PUBLIC_KEY=keys/sandbox.pem

# Optional: where the session token is cached (default: .token-<env>-<gstin>.json next to this file)
# EINV_TOKEN_FILE=

# Optional: request payload encoding before AES encryption. "base64" (NIC spec, default) or "json".
# EINV_PAYLOAD_ENCODING=base64
